{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/music/**",
              "components/practice/**",
              "components/sheet/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Sans|JetBrains Mono|Noto Music|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Instrument Sans, JetBrains Mono, Noto Music, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|disabled|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, disabled, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:primary|control|pill)$/]",
        "message": "<Button> size must be one of 'primary' | 'control' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChordChartBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:chord|current|key|ref|className|style|children)$/]",
        "message": "<ChordChartBar> doesn't accept that prop. Declared props: chord, current."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormatBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:format|assigned|size|style|key|ref|className|style|children)$/]",
        "message": "<FormatBadge> doesn't accept that prop. Declared props: format, assigned, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|shape|size|label|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, shape, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|square)$/]",
        "message": "<IconButton> shape must be one of 'circle' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LeadSheetBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:chord|lyric|dim|key|ref|className|style|children)$/]",
        "message": "<LeadSheetBar> doesn't accept that prop. Declared props: chord, lyric, dim."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:cells|marked|key|ref|className|style|children)$/]",
        "message": "<LogRow> doesn't accept that prop. Declared props: cells, marked."
      },
      {
        "selector": "JSXOpeningElement[name.name='MeterRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|max|tone|suffix|labelWidth|style|key|ref|className|style|children)$/]",
        "message": "<MeterRow> doesn't accept that prop. Declared props: label, value, max, tone, suffix, labelWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MeterRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:mint|amber|clay)$/]",
        "message": "<MeterRow> tone must be one of 'mint' | 'amber' | 'clay'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotationGlyph'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|context|color|size|style|key|ref|className|style|children)$/]",
        "message": "<NotationGlyph> doesn't accept that prop. Declared props: name, context, color, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotationGlyph'] > JSXAttribute[name.name='context'] > Literal[value!=/^(?:staff|badge|cell|inline)$/]",
        "message": "<NotationGlyph> context must be one of 'staff' | 'badge' | 'cell' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|state|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: padding, state, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:card|panel|roomy)$/]",
        "message": "<Panel> padding must be one of 'card' | 'panel' | 'roomy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:resting|current|cleared|empty)$/]",
        "message": "<Panel> state must be one of 'resting' | 'current' | 'cleared' | 'empty'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PieceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|format|assigned|pill|actionLabel|onOpen|style|key|ref|className|style|children)$/]",
        "message": "<PieceRow> doesn't accept that prop. Declared props: title, meta, format, assigned, pill, actionLabel, onOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: tone, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|mint|amber|clay)$/]",
        "message": "<Pill> tone must be one of 'neutral' | 'mint' | 'amber' | 'clay'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QueueRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|title|detail|duration|state|settings|draggable|style|key|ref|className|style|children)$/]",
        "message": "<QueueRow> doesn't accept that prop. Declared props: index, title, detail, duration, state, settings, draggable, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QueueRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:pending|current|done)$/]",
        "message": "<QueueRow> state must be one of 'pending' | 'current' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: size, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:label|meta)$/]",
        "message": "<SectionLabel> size must be one of 'label' | 'meta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:total|filled|current|height|radius|gap|style|key|ref|className|style|children)$/]",
        "message": "<SegmentBar> doesn't accept that prop. Declared props: total, filled, current, height, radius, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SheetPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|style|key|ref|className|style|children)$/]",
        "message": "<SheetPanel> doesn't accept that prop. Declared props: children, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StaffSystem'] > JSXAttribute > JSXIdentifier[name!=/^(?:clef|top|keySignature|timeSignature|timeLeft|key|ref|className|style|children)$/]",
        "message": "<StaffSystem> doesn't accept that prop. Declared props: clef, top, keySignature, timeSignature, timeLeft."
      },
      {
        "selector": "JSXOpeningElement[name.name='StaffSystem'] > JSXAttribute[name.name='clef'] > Literal[value!=/^(?:treble|bass|alto)$/]",
        "message": "<StaffSystem> clef must be one of 'treble' | 'bass' | 'alto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|delta|tone|style|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, unit, delta, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|mint|amber|clay)$/]",
        "message": "<StatTile> tone must be one of 'default' | 'mint' | 'amber' | 'clay'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|style|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Waveform'] > JSXAttribute > JSXIdentifier[name!=/^(?:bars|height|tone|style|key|ref|className|style|children)$/]",
        "message": "<Waveform> doesn't accept that prop. Declared props: bars, height, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Waveform'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:resting|mint)$/]",
        "message": "<Waveform> tone must be one of 'resting' | 'mint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeekDay'] > JSXAttribute > JSXIdentifier[name!=/^(?:letter|state|minutes|key|ref|className|style|children)$/]",
        "message": "<WeekDay> doesn't accept that prop. Declared props: letter, state, minutes."
      },
      {
        "selector": "JSXOpeningElement[name.name='WeekDay'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:played|today|playing|rest|future)$/]",
        "message": "<WeekDay> state must be one of 'played' | 'today' | 'playing' | 'rest' | 'future'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
